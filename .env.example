# Enables upload and inference routes only when explicitly set to true.
PLAN_IMPORT_ENABLED=false

# ── Vision provider (pick one) ────────────────────────────────────────────────

# Force a provider explicitly: agent-router | rodium-ai | claude-holistic | claude-api | claude-agent | gemini | worker
# When unset: agent-router > rodium-ai > claude > gemini > worker (by API key precedence)
VISION_PROVIDER=

# Highest Priority — AgentRouter (Gemini 3.1 + GPT 5.6 Luna with intelligent routing)
# Set VISION_PROVIDER=agent-router to activate. Requires AGENT_ROUTER_API_KEY.
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://api.agentrouter.org/v1

# Second Priority — Rodium AI (Gemini 3.1 + GPT 5.6 Luna with Rodium orchestration)
# Set VISION_PROVIDER=rodium-ai to activate. Requires RODIUM_AI_API_KEY.
RODIUM_AI_API_KEY=
RODIUM_AI_BASE_URL=https://api.rodiumai.io/v1

# Third Priority — Claude API (Anthropic)
# Set VISION_PROVIDER=claude-holistic or claude-api to activate.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Option 0 — Claude Agent SDK (local dev, no API key)
# Uses your local Claude Code install + your own Claude auth.
# Set VISION_PROVIDER=claude-agent to activate. Optional model override:
CLAUDE_AGENT_MODEL=

# Option A — Google Gemini (free tier, recommended for development)
# Get a free key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# Model to use (default: gemini-2.0-flash-lite). Options: gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=

# Option B — RunPod Serverless (production, bring your own worker)
# Deploy a worker that returns ReconstructionResultV1 JSON.
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Option C — Local worker via Podman/Docker (no key needed, mock output)
# Run: cd vision-worker && podman build -t corbel-vision-worker -f Containerfile .
#      podman run -d -p 8787:8787 corbel-vision-worker
VISION_WORKER_URL=

# ── File storage ──────────────────────────────────────────────────────────────

# Vercel Blob — required for production uploads.
# Get from: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# In development without a Blob token, local upload is used automatically
# (files saved to .next/local-uploads/, served at /api/plan-import/local-upload/).

# ── Source host allowlist ─────────────────────────────────────────────────────

# Comma-separated additional hosts the inference proxy will accept image URLs from.
# Vercel Blob (*.blob.vercel-storage.com) and localhost are always allowed.
PLAN_IMPORT_ALLOWED_HOSTS=
