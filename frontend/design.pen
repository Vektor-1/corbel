                        {
                          "type": "text",
                          "id": "ZqsKT",
                          "name": "By default, every 1×1×1 unit renders its",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 135.19,
                          "content": "By default, every 1×1×1 unit renders its own distinct stroke. To fuse a shape into a single, visually seamless solid, simply assign the stroke the exact same color as the fill, effectively rendering the internal grid geometry invisible.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
