                  ],
                  "children": [
                    {
                      "type": "frame",
                      "id": "naPOl",
                      "name": "h1",
                      "context": "h1",
                      "width": 518.41,
                      "height": 196.19,
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "text",
                          "id": "F8x6r1",
                          "name": "heerich.js",
                          "fill": "#fbf4ea",
                          "content": "heerich.js",
                          "lineHeight": 1,
                          "fontFamily": "Aboreto",
                          "fontSize": 71.86,
                          "fontWeight": "normal",
                          "letterSpacing": -3.59
                        },
                        {
                          "type": "text",
                          "id": "n7EDN",
                          "name": "0.16.0",
                          "context": "span",
                          "fill": "#615f5c",
                          "content": "0.16.0",
                          "lineHeight": 1,
                          "fontFamily": "Work Sans",
                          "fontSize": 12.93,
                          "fontWeight": "300"
                        },
                        {
                          "type": "text",
                          "id": "PPE09",
                          "name": "A tiny engine for 3D voxel scenes render",
                          "context": "small",
                          "fill": "#797672",
                          "content": "A tiny engine for 3D voxel scenes rendered to SVG",
                          "lineHeight": 1,
                          "fontFamily": "Work Sans",
                          "fontSize": 14.37,
                          "fontWeight": "300"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "tKtH5",
                      "name": "heerich.js is a minimalist JavaScript en",
                      "context": "p",
                      "fill": "#fbf4ea",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 112.66,
                      "content": "heerich.js is a minimalist JavaScript engine that constructs 3D voxel compositions and distills them into pristine SVG. By extruding volumes, carving negative space, and applying boolean operations, you wield a programmatic chisel—projecting complex spatial arrangements into a flat, resolution-independent vector canvas.",
                      "lineHeight": 1.65,
                      "fontFamily": "Work Sans",
                      "fontSize": 13.65,
                      "fontWeight": "300"
                    },
                    {
                      "type": "text",
                      "id": "y9drq6",
                      "name": "While SVG trades raw frame-rates for arc",
                      "context": "p",
                      "fill": "#fbf4ea",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 112.66,
                      "content": "While SVG trades raw frame-rates for architectural elegance, its integration with the DOM is profound. The resulting geometry sits natively within the browser, inviting manipulation through CSS and uncompromised infinite scaling. The output is not an ephemeral pixel buffer, but semantic, stylable, and enduring markup.",
                      "lineHeight": 1.65,
                      "fontFamily": "Work Sans",
                      "fontSize": 13.65,
                      "fontWeight": "300"
                    },
                    {
                      "type": "text",
                      "id": "XeMMW",
                      "name": "The visual language draws deep inspirati",
                      "context": "p",
                      "fill": "#fbf4ea",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 72.13,
                      "content": "The visual language draws deep inspiration from the geometric rigor of Erwin Heerich† (1922–2004) — exploring stacked topologies, deliberate subtractions, and the quiet tension that exists between solid mass and absolute void.",
                      "lineHeight": 1.65,
                      "fontFamily": "Work Sans",
                      "fontSize": 13.65,
                      "fontWeight": "300"
                    },
                    {
                      "type": "text",
                      "id": "Y9Vy4",
                      "name": "This page serves as both a technical man",
                      "context": "p",
                      "fill": "#fbf4ea",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 67.59,
                      "content": "This page serves as both a technical manual and an interactive gallery. Engage with the examples below to comprehend the mechanics of the engine one primitive at a time.",
                      "lineHeight": 1.65,
                      "fontFamily": "Work Sans",
                      "fontSize": 13.65,
                      "fontWeight": "300"
                    }
                  ]
                },
