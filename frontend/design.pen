                      "children": [
                        {
                          "type": "text",
                          "id": "vLsdZ",
                          "name": "findByPosition([x, y]) performs a 2D scr",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 157.72,
                          "content": "findByPosition([x, y]) performs a 2D screen-space hit test against all projected faces, returning the frontmost voxel and face at that position. Coordinates are in the same pixel space as getFaces() — when working from mouse events on a rendered SVG, use the SVG element's coordinate transform to convert:",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
                      ]
