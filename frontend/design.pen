                        {
                          "type": "text",
                          "id": "MNHhZ",
                          "name": "Conversely, removeGeometry({ type: 'sphe",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 112.66,
                          "content": "Conversely, removeGeometry({ type: 'sphere' }) carves a hollow void using the exact same parameters. Layer a sphere subtraction into a solid box to effortlessly create arched doorways or dome cutouts.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
                      ]
