                        {
                          "type": "text",
                          "id": "R9nQC",
                          "name": "The getNeighbors() query explicitly retr",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 157.72,
                          "content": "The getNeighbors() query explicitly retrieves adjacent solid geometry across the six cardinal planes. In the interactive demo, individual cubes compute their overall exposure count — completely encased shapes remain flat, while openly protruding forms inherit high-contrast luminance.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
