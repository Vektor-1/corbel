                          "id": "HnLV5",
                          "name": "These callbacks are invoked exactly once",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 112.66,
                          "content": "These callbacks are invoked exactly once at voxel creation. Individual faces can possess their own isolated functions — letting you freely cross-pollinate static hues with calculated spectral shifts.",
