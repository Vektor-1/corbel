                      "children": [
                        {
                          "type": "text",
                          "id": "C8ryhO",
                          "name": "Instead of static objects, styles can be",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 157.72,
                          "content": "Instead of static objects, styles can be assigned as pure computing functions tracking over (x, y, z) parameters. This effortlessly powers cascading gradients, periodic patterns, or geometry-dependent shading rules — bypassing the need to iterate through individual voxels manually.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
                      ]
