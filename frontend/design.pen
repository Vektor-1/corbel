                      "children": [
                        {
                          "type": "text",
                          "id": "l8521",
                          "name": "You can embed pure SVG arbitrarily into ",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 157.72,
                          "content": "You can embed pure SVG arbitrarily into volumetric cells by injecting a literal content string. The engine intercepts these strings, seamlessly calculates their projected 2D location alongside other faces, enforces a strict Z-level depth sort, and encases everything cleanly inside an integrated <g> element.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
                      ]
                    },
