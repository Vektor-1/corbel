                        {
                          "type": "text",
                          "id": "S602y",
                          "name": "Set opaque: false and the voxel itself r",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 157.72,
                          "content": "Set opaque: false and the voxel itself remains visible, but adjacent voxels treat it as empty space — forcing their inner faces to be drawn. Combine this with a transparent fill to construct wireframe cages, bounding volumes, or see-through sculptural guides anchored cleanly over solid geometry.",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
