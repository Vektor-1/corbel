                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "FFy0J",
                          "name": "The engine tracks styles on a strict per",
                          "context": "p",
                          "fill": "#fbf4ea",
                          "textGrowth": "fixed-width-height",
                          "width": 307.63,
                          "height": 202.78,
                          "content": "The engine tracks styles on a strict per-face basis: top, front, left, right, bottom, and back, alongside a default fallback. The axis shorthands x (left + right), y (top + bottom) and z (front + back) paint both faces of an axis at once — an explicit face still overrides them. You can inject these styles during shape creation, or explicitly overwrite existing regions later using applyStyle().",
                          "lineHeight": 1.65,
                          "fontFamily": "Work Sans",
                          "fontSize": 13.65,
                          "fontWeight": "300"
                        }
                      ]
