                  "name": "All parameters are optional — new Heeric",
                  "context": "p",
                  "fill": "#fbf4ea",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 45.06,
                  "content": "All parameters are optional — new Heerich() works with sensible defaults. Call heerich.toSVG() to get an SVG string you can drop into the DOM.",
