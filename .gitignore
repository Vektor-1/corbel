# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root: patterns apply across frontend/, backend/, and ml/.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python virtual environments and caches
__pycache__/
*.py[cod]
.venv/
.venv_*/
venv/

# vercel
.vercel

# local benchmark output (regeneratable)
benchmark_out/
frontend/scripts/.bench-cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# ml/: training code is tracked, large artifacts and datasets are not.
# (frontend/public/models/*.onnx is a committed runtime asset, not excluded here.)
ml/dataset
ml/dataset_seg/
ml/cubicasa5k_coco/
ml/colab-checkpoints/
ml/kaggle_download.log
ml/runs/
ml/g0/
ml/synth/*.zip
ml/*.onnx
ml/*.pt
